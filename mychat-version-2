
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MyChat</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#050817;color:white;font-family:Arial,sans-serif}
header{padding:18px;text-align:center;color:#35E9FF;font-size:30px;font-weight:900;text-shadow:0 0 12px #35E9FF;border-bottom:1px solid #16445d}
nav{display:flex;justify-content:center;gap:10px;padding:12px;flex-wrap:wrap}
button{background:#102b45;color:#35E9FF;border:1px solid #1688a5;border-radius:9px;padding:10px 14px;font-weight:bold;cursor:pointer}
button:hover{background:#164566}
button:disabled{opacity:.35;cursor:not-allowed}
#app{width:100%;max-width:850px;margin:auto;padding:12px;min-width:0}
.panel{width:100%;min-width:0;background:#081528;border:1px solid #16445d;border-radius:14px;padding:14px;margin-bottom:12px}
input{width:100%;min-width:0;padding:13px;border-radius:9px;border:1px solid #1688a5;background:#071426;outline:none;font-size:16px}
#input,#helpInput{color:#FF8A24!important;-webkit-text-fill-color:#FF8A24!important;caret-color:#FF8A24!important}
#input::placeholder,#helpInput::placeholder{color:#35E9FF!important;-webkit-text-fill-color:#35E9FF!important;opacity:.7}
.chat-tabs{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:12px;min-width:0}
.chat-tab{display:flex;gap:5px;align-items:center;min-width:0}
.chat-tab button{padding:8px 11px}
.chat-tab .close{color:#ff7777;border-color:#824444;padding:7px 9px}
.messages{display:flex;flex-direction:column;gap:10px;width:100%;min-width:0;height:360px;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;background:#020914;border:1px solid #153a50;border-radius:10px;padding:12px;scroll-behavior:smooth;scrollbar-width:thin;scrollbar-color:#1688a5 #020914}
.message{display:block;width:fit-content;max-width:85%;min-width:0;padding:11px 13px;border-radius:12px;line-height:1.4;white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word;flex-shrink:0}
.user{align-self:flex-end;background:#17314B;border:1px solid #FF8A24;color:#FF8A24}
.bot{align-self:flex-start;background:#10253A;border:1px solid #167E9B;color:#35E9FF}
.scroll-controls{display:flex;justify-content:space-between;gap:10px;margin:10px 0}
.scroll-controls button{flex:1;min-width:0}
.send-row{display:flex;gap:8px;margin-top:10px;min-width:0}
.send-row input{flex:1;min-width:0}
.send-row button{white-space:nowrap}
.preview{margin-top:8px;color:#35E9FF;font-size:13px;min-height:19px;overflow-wrap:anywhere}
.preview strong{color:#FF8A24;font-weight:normal;overflow-wrap:anywhere}
#helpTyping{display:none;color:#35E9FF;padding:10px 4px;font-weight:bold}
#helpTyping .dots{display:inline-block;animation:pulse 1s infinite}
@keyframes pulse{0%,100%{opacity:.35}50%{opacity:1}}
.page-title{color:#35E9FF;font-size:21px;font-weight:bold;margin:5px 0 12px}
.hidden{display:none!important}
</style>
</head>
<body>
<header>MyChat</header>

<nav>
<button onclick="openPage('main')">My Chats</button>
<button onclick="openPage('help')">Help Chat</button>
</nav>

<div id="app">

<section id="mainPage" class="panel">
<div class="page-title">My Chats</div>
<div id="chatTabs" class="chat-tabs"></div>
<div id="messages" class="messages"></div>

<div class="scroll-controls">
<button id="mainUp" onclick="scrollChat(-1)">↑ Scroll Up</button>
<button id="mainDown" onclick="scrollChat(1)">↓ Scroll Down</button>
</div>

<div class="send-row">
<input id="input" placeholder="Type a message..." oninput="updatePreview()" onkeydown="handleMainEnter(event)">
<button onclick="sendMessage()">Send</button>
</div>

<div class="preview">Typing preview: <strong id="previewText">...</strong></div>
</section>

<section id="helpPage" class="panel hidden">
<div class="page-title">Help Chat — Helpbot</div>
<div id="helpMessages" class="messages"></div>

<div class="scroll-controls">
<button id="helpUp" onclick="scrollChat(-1)">↑ Scroll Up</button>
<button id="helpDown" onclick="scrollChat(1)">↓ Scroll Down</button>
</div>

<div class="send-row">
<input id="helpInput" placeholder="Ask Helpbot something..." oninput="updateHelpPreview()" onkeydown="handleHelpEnter(event)">
<button id="helpSendButton" onclick="sendHelp()">Send</button>
</div>

<div class="preview">Typing preview: <strong id="helpPreviewText">...</strong></div>
<div id="helpTyping">💬 Helpbot is typing<span class="dots">...</span></div>
</section>

</div>

<script>
let currentPage="main",nextChatId=2,activeChatId=1;
let helpScrollTop=0,helpSending=false,helpTimer=null;
let replyCount=0;

let chats=[{
id:1,
name:"Chat 1",
messages:[{who:"bot",text:"Welcome to MyChat!"}],
scrollTop:0
}];

let helpMessages=[{
who:"bot",
text:"Hey! I'm Helpbot. Ask me for jokes, riddles, facts, or help using MyChat!"
}];

function createChat(){
saveScrollPosition();
const id=nextChatId++;
chats.push({
id,
name:"Chat "+id,
messages:[{who:"bot",text:"New chat started! What would you like to talk about?"}],
scrollTop:0
});
activeChatId=id;
renderMain();
document.getElementById("input").focus();
}

function switchChat(id){
saveScrollPosition();
activeChatId=id;
renderMain();
}

function closeChat(id){
if(chats.length===1){
alert("You need to keep at least one chat open!");
return;
}
saveScrollPosition();
chats=chats.filter(c=>c.id!==id);
if(activeChatId===id)activeChatId=chats[0].id;
renderMain();
}

function openPage(page){
saveScrollPosition();
currentPage=page;
document.getElementById("mainPage").classList.toggle("hidden",page!=="main");
document.getElementById("helpPage").classList.toggle("hidden",page!=="help");
if(page==="main")renderMain();
else renderHelp();
}

function getCurrentArea(){
return currentPage==="help"
?document.getElementById("helpMessages")
:document.getElementById("messages");
}

function saveScrollPosition(){
const area=getCurrentArea();
if(!area)return;

if(currentPage==="help"){
helpScrollTop=area.scrollTop;
}else{
const chat=chats.find(c=>c.id===activeChatId);
if(chat)chat.scrollTop=area.scrollTop;
}
}

function restoreScrollPosition(area,position){
requestAnimationFrame(()=>{
area.scrollTop=position;
updateScrollButtons();
});
}

function updateScrollButtons(){
const area=getCurrentArea();
if(!area)return;

const up=document.getElementById(
currentPage==="help"?"helpUp":"mainUp"
);

const down=document.getElementById(
currentPage==="help"?"helpDown":"mainDown"
);

if(!up||!down)return;

const max=Math.max(0,area.scrollHeight-area.clientHeight);
up.disabled=area.scrollTop<=1;
down.disabled=area.scrollTop>=max-1;
}

function scrollChat(direction){
const area=getCurrentArea();
if(!area)return;

const max=Math.max(0,area.scrollHeight-area.clientHeight);

const target=direction<0
?Math.max(0,area.scrollTop-250)
:Math.min(max,area.scrollTop+250);

area.scrollTo({top:target,behavior:"smooth"});

if(currentPage==="help"){
helpScrollTop=target;
}else{
const chat=chats.find(c=>c.id===activeChatId);
if(chat)chat.scrollTop=target;
}
}

function renderTabs(){
const holder=document.getElementById("chatTabs");
holder.innerHTML="";

chats.forEach(chat=>{
const wrapper=document.createElement("div");
wrapper.className="chat-tab";

const tab=document.createElement("button");
tab.textContent=chat.name;
tab.style.borderColor=chat.id===activeChatId?"#35E9FF":"#16445d";
tab.onclick=()=>switchChat(chat.id);

const close=document.createElement("button");
close.className="close";
close.textContent="×";
close.onclick=()=>closeChat(chat.id);

wrapper.append(tab,close);
holder.appendChild(wrapper);
});

const add=document.createElement("button");
add.textContent="+ New Chat";
add.onclick=createChat;
holder.appendChild(add);
}

function addBubble(area,message){
const bubble=document.createElement("div");
bubble.className="message "+message.who;
bubble.textContent=message.text;
area.appendChild(bubble);
}

function renderMain(){
renderTabs();
const area=document.getElementById("messages");
area.innerHTML="";

const chat=chats.find(c=>c.id===activeChatId);
if(!chat)return;

chat.messages.forEach(message=>addBubble(area,message));
restoreScrollPosition(area,chat.scrollTop);
}

function renderHelp(){
const area=document.getElementById("helpMessages");
area.innerHTML="";

helpMessages.forEach(message=>addBubble(area,message));

document.getElementById("helpTyping").style.display=
helpSending?"block":"none";

document.getElementById("helpSendButton").disabled=helpSending;

restoreScrollPosition(area,helpScrollTop);
}

function updatePreview(){
const v=document.getElementById("input").value;
document.getElementById("previewText").textContent=v||"...";
}

function updateHelpPreview(){
const v=document.getElementById("helpInput").value;
document.getElementById("helpPreviewText").textContent=v||"...";
}

function handleMainEnter(event){
if(event.key==="Enter"){
event.preventDefault();
sendMessage();
}
}

function sendMessage(){
const input=document.getElementById("input");
const text=input.value.trim();
if(!text)return;

const chat=chats.find(c=>c.id===activeChatId);
if(!chat)return;

chat.messages.push({who:"user",text});
input.value="";
updatePreview();

chat.scrollTop=999999;
renderMain();
input.focus();
}

/* HELPBOT RESPONSE GENERATOR */

function combineLists(first,second,make){
const result=[];
first.forEach(a=>{
second.forEach(b=>{
result.push(make(a,b));
});
});
return result;
}

const openerA=[
"Here's something interesting",
"Absolutely",
"Good question",
"Let's explore",
"Check this out",
"Here's a fun idea",
"Sure thing",
"I've got an answer",
"Let's figure this out",
"Welcome to another answer"
];

const openerB=[
"for you",
"to get started",
"about that",
"just for fun",
"to help you",
"today",
"for your next chat",
"worth knowing",
"to explore together",
"right now"
];

const endingA=[
"Hope that helps",
"Keep exploring",
"That's a fun fact",
"Thanks for asking",
"Let's keep learning",
"Stay curious",
"Have fun with it",
"You're doing great",
"Keep those questions coming",
"Enjoy MyChat"
];

const endingB=[
"and have a great day",
"whenever you're ready",
"one step at a time",
"there's always more to learn",
"keep up the curiosity",
"and keep thinking",
"that's what learning is about",
"and enjoy the journey",
"until the next question",
"let's keep going"
];

const openers=combineLists(openerA,openerB,(a,b)=>a+" "+b+"!");
const endings=combineLists(endingA,endingB,(a,b)=>a+" "+b+".");

const jokeA=[
"Why did the computer go to the doctor? Because it caught a virus!",
"Why was the math book sad? It had too many problems!",
"Why did the bicycle fall over? It was two-tired!",
"What do you call a bear with no teeth? A gummy bear!",
"Why did the cookie go to the hospital? It felt crummy!",
"Why was the computer cold? It left its Windows open!",
"What do clouds wear? Thunderwear!",
"Why did the student eat homework? The teacher said it was a piece of cake!",
"What do you call a sleeping dinosaur? A dino-snore!",
"Why did the robot go on vacation? It needed to recharge!"
];

const jokeB=[
"That joke is powered by pure imagination.",
"Even the keyboard couldn't stop laughing.",
"Sometimes the simplest jokes are the best.",
"Technology definitely has a funny side.",
"That's one way to make a boring day better.",
"Humor can be found in the strangest places.",
"Even a robot needs a good laugh.",
"That one deserves a spot in a joke book.",
"Never underestimate a silly question.",
"There's always room for another joke."
];

const factA=[
"Octopuses have three hearts.",
"Some bamboo species can grow extremely quickly.",
"Jupiter is the largest planet in our solar system.",
"Sharks existed before trees.",
"A group of flamingos is called a flamboyance.",
"Saturn has a spectacular ring system.",
"Bees communicate food locations through movement.",
"Some turtles can live for many decades.",
"Lightning is hotter than the surface of the Sun.",
"The Moon has a very thin exosphere."
];

const factB=[
"Nature contains many surprising adaptations.",
"Scientists continue studying this fascinating subject.",
"It shows how interesting our world can be.",
"Space and science are full of discoveries.",
"Small details can reveal something amazing.",
"There is always more to learn about nature.",
"Curiosity helps us discover new information.",
"Science makes the world easier to understand.",
"Even familiar things can have surprising details.",
"Learning about the universe never gets boring."
];

const riddleA=[
"What has keys but cannot open locks? A piano!",
"What has hands but cannot clap? A clock!",
"What gets wetter as it dries? A towel!",
"What has a neck but no head? A bottle!",
"What has one eye but cannot see? A needle!",
"What has many teeth but cannot bite? A comb!",
"What goes up but never comes down? Your age!",
"What has words but never speaks? A book!",
"What has a ring but no finger? A telephone!",
"What can travel around the world while staying in one corner? A stamp!"
];

const riddleB=[
"Try thinking about everyday objects.",
"The answer is something you might see at home.",
"Sometimes the answer is simpler than it sounds.",
"Look at the words carefully for a clue.",
"Every good puzzle rewards careful thinking.",
"Try another riddle after solving this one.",
"Wordplay can make puzzles extra interesting.",
"Think outside the box for the next one.",
"Riddles are a fun way to exercise your brain.",
"Keep practicing your problem-solving skills."
];

const helpA=[
"To start a new MyChat conversation, select the New Chat button.",
"You can switch conversations by selecting their chat tabs.",
"Use the scroll buttons to move through your messages.",
"Help Chat is where you can ask Helpbot questions.",
"Your typed message appears in the typing preview.",
"Press Enter to send a message from the keyboard.",
"You can close a chat using its X button.",
"MyChat keeps separate message lists for each chat.",
"The Helpbot typing indicator appears while it prepares a reply.",
"You can use the navigation buttons to switch between pages."
];

const helpB=[
"Try testing the feature with a short message.",
"Check that you are on the correct page first.",
"If something looks wrong, refresh the page.",
"Keep your messages inside the chat area.",
"Try the button again after the current reply finishes.",
"Make sure your browser has JavaScript enabled.",
"Testing one feature at a time makes troubleshooting easier.",
"You can use the chat tabs to organize conversations.",
"Try the feature again with a different message.",
"That's a useful feature to know about."
];

const jokes=combineLists(jokeA,jokeB,(a,b)=>a+" "+b);
const facts=combineLists(factA,factB,(a,b)=>"Fun fact: "+a+" "+b);
const riddles=combineLists(riddleA,riddleB,(a,b)=>a+" "+b);
const mychat=combineLists(helpA,helpB,(a,b)=>a+" "+b);

/*
100 openers x 100 content variations x 100 endings
= 1,000,000 combinations per category.
4 categories = 4,000,000 possible combinations.
*/

function hashText(text){
let hash=0;
for(let i=0;i<text.length;i++){
hash=(hash*31+text.charCodeAt(i))>>>0;
}
return hash;
}

function helpbotReply(message){

const q=message.toLowerCase().replace(/[?!.,]/g,"").trim();

/* SPECIAL ANSWER COUNT TRIGGER */

if(
q.includes("how much answers do you have")||
q.includes("how many answers do you have")||
q.includes("how much answers")||
q.includes("how many answers")||
q.includes("how many responses do you have")||
q.includes("how many replies do you have")||
q.includes("how many combinations do you have")
){
return "I have up to 4 MILLION possible response combinations! I can answer with jokes, riddles, fun facts, and MyChat help! 🎉";
}

const hash=hashText(q+"-"+replyCount++);

let category,cores;

if(q.includes("riddle")||q.includes("puzzle")||q.includes("guess")){
category="riddle";
cores=riddles;
}
else if(
q.includes("mychat")||
q.includes("chat")||
q.includes("button")||
q.includes("scroll")||
q.includes("tab")||
q.includes("broken")||
q.includes("work")||
q.includes("fix")
){
category="mychat";
cores=mychat;
}
else if(
q.includes("fact")||
q.includes("animal")||
q.includes("space")||
q.includes("ocean")||
q.includes("planet")||
q.includes("nature")
){
category="fact";
cores=facts;
}
else{
category="joke";
cores=jokes;
}

const opener=openers[hash%100];
const core=cores[Math.floor(hash/100)%100];
const ending=endings[Math.floor(hash/10000)%100];

return opener+" "+core+" "+ending;
}

function handleHelpEnter(event){
if(event.key==="Enter"){
event.preventDefault();
sendHelp();
}
}

function sendHelp(){
if(helpSending)return;

const input=document.getElementById("helpInput");
const text=input.value.trim();
if(!text)return;

helpMessages.push({who:"user",text});
input.value="";
updateHelpPreview();

helpSending=true;
helpScrollTop=999999;
renderHelp();

const reply=helpbotReply(text);

helpTimer=setTimeout(()=>{
helpMessages.push({who:"bot",text:reply});
helpScrollTop=999999;
helpSending=false;
helpTimer=null;
renderHelp();
document.getElementById("helpInput").focus();
},4000);
}

function addScrollListeners(){
["messages","helpMessages"].forEach(id=>{
const area=document.getElementById(id);

area.addEventListener("scroll",()=>{
if(
(id==="helpMessages"&&currentPage==="help")||
(id==="messages"&&currentPage==="main")
){
saveScrollPosition();
updateScrollButtons();
}
});
});
}

addScrollListeners();
renderMain();
renderHelp();
openPage("main");

</script>
</body>
</html>
